{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "bot_id": {
      "type": "string",
      "enum": [
        "B15"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "REPAIR",
        "BLOCK",
        "FAIL"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "fact_audit.json": {
          "type": "string"
        },
        "corrected_script.md": {
          "type": "string"
        }
      },
      "required": [
        "fact_audit.json",
        "corrected_script.md"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "bot_id",
    "status",
    "payload"
  ]
}