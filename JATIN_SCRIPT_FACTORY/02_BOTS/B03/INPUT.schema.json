{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "bot_id": {
      "type": "string",
      "enum": [
        "B03"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "normalized_sources": {
          "type": [
            "string",
            "object",
            "array"
          ]
        },
        "sampling_rules": {
          "type": "object"
        }
      },
      "required": [
        "normalized_sources",
        "sampling_rules"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "bot_id",
    "payload"
  ]
}