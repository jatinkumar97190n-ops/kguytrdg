{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "bot_id": {
      "type": "string",
      "enum": [
        "B02"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "REPAIR",
        "BLOCK",
        "FAIL"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "normalized_sources.jsonl": {
          "type": "string"
        },
        "ingestion_report.json": {
          "type": "string"
        }
      },
      "required": [
        "normalized_sources.jsonl",
        "ingestion_report.json"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "bot_id",
    "status",
    "payload"
  ]
}