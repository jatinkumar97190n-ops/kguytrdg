{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "bot_id": {
      "type": "string",
      "enum": [
        "B02"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "creator_urls": {
          "type": "string"
        },
        "permissions": {
          "type": [
            "string",
            "object",
            "array"
          ]
        },
        "source_manifest": {
          "type": "string"
        }
      },
      "required": [
        "creator_urls",
        "permissions",
        "source_manifest"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "bot_id",
    "payload"
  ]
}