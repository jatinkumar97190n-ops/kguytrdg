{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "bot_id": {
      "type": "string",
      "enum": [
        "B07"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "REPAIR",
        "BLOCK",
        "FAIL"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "research_plan.json": {
          "type": "string"
        }
      },
      "required": [
        "research_plan.json"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "bot_id",
    "status",
    "payload"
  ]
}