{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "bot_id": {
      "type": "string",
      "enum": [
        "B20"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "packaging": {
          "type": [
            "string",
            "object",
            "array"
          ]
        },
        "research": {
          "type": [
            "string",
            "object",
            "array"
          ]
        },
        "creator_dna": {
          "type": [
            "string",
            "object",
            "array"
          ]
        }
      },
      "required": [
        "packaging",
        "research",
        "creator_dna"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "bot_id",
    "payload"
  ]
}