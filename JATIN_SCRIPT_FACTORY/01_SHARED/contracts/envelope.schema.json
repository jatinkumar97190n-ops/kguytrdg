{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.0.0"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "bot_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer"
    },
    "input_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_artifact_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "REPAIR",
        "BLOCK",
        "FAIL"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    },
    "model_info": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "bot_id",
    "attempt",
    "status",
    "input_artifact_ids",
    "output_artifact_id",
    "created_at",
    "payload"
  ]
}